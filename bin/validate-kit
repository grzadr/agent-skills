#!/usr/bin/env bash
set -euo pipefail

KIT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ERRORS=0; WARNINGS=0; CHECKED=0

pass()    { printf "  \033[1;32m[PASS]\033[0m %s\n" "$1"; }
fail()    { printf "  \033[1;31m[FAIL]\033[0m %s -> %s\n" "$1" "$2"; ERRORS=$((ERRORS + 1)); }
warn()    { printf "  \033[1;33m[WARN]\033[0m %s -> %s\n" "$1" "$2"; WARNINGS=$((WARNINGS + 1)); }
section() { printf "\n\033[1;34m=== %s ===\033[0m\n" "$1"; }

# Single-pass frontmatter + body parser: outputs 5 lines (bounds, body, name, description, trigger)
parse_md() {
  awk '
    function clean(v) {
      sub(/^[^:]+:[[:space:]]*/, "", v)
      if (v !~ /^["\x27]/) sub(/[[:space:]]+#.*$/, "", v)
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      if ((v ~ /^".*"$/) || (v ~ /^\x27.*\x27$/)) v = substr(v, 2, length(v) - 2)
      return v
    }
    NR == 1 && /^---[[:space:]]*$/ { in_fm = 1; next }
    in_fm && /^---[[:space:]]*$/   { in_fm = 0; bounds = 1; in_body = 1; next }
    in_fm && /^name:[[:space:]]*/        { name = clean($0) }
    in_fm && /^description:[[:space:]]*/ { desc = clean($0) }
    in_fm && /^trigger:[[:space:]]*/     { trig = clean($0) }
    in_body && /[^[:space:]]/            { body = 1; exit }
    END { printf "%d\n%d\n%s\n%s\n%s\n", bounds, body, name, desc, trig }
  ' "$1"
}

validate_json_file() {
  local file="$1" rel="${1#${KIT_ROOT}/}"
  CHECKED=$((CHECKED + 1))
  if [[ -f "$file" ]] && jq -e '.name and (.name|length>0) and .description and (.description|length>0)' "$file" >/dev/null 2>&1; then
    pass "$rel"
  else
    fail "$rel" "Missing file, invalid JSON, or empty 'name'/'description'"
  fi
}

validate_named_md() {
  local file="$1" check_folder="${2:-0}" rel="${1#${KIT_ROOT}/}" errs=0
  CHECKED=$((CHECKED + 1))
  local lines=()
  while IFS= read -r line; do lines+=("$line"); done < <(parse_md "$file")
  local bounds="${lines[0]}" body="${lines[1]}" name="${lines[2]}" desc="${lines[3]}"

  [[ "$bounds" -eq 1 ]] || { fail "$rel" "Missing valid YAML frontmatter ('---' bounds)"; return; }
  [[ -n "$desc" ]]      || { fail "$rel" "Missing 'description' in frontmatter"; errs=1; }
  if [[ -z "$name" && "$check_folder" -eq 0 ]]; then
    fail "$rel" "Missing 'name' in frontmatter"; errs=1
  elif [[ -n "$name" ]]; then
    [[ "$name" =~ ^[a-z0-9-]+$ ]] || { fail "$rel" "Name '$name' must be lowercase kebab-case"; errs=1; }
    local folder; folder="$(basename "$(dirname "$file")")"
    [[ "$check_folder" -eq 1 && "$name" != "$folder" ]] && warn "$rel" "Name '$name' != folder '$folder'"
  fi
  [[ "$body" -eq 1 ]] || { fail "$rel" "Markdown body after frontmatter is empty"; errs=1; }
  [[ "$errs" -eq 0 ]] && pass "$rel"
}

validate_rule_file() {
  local file="$1" rel="${1#${KIT_ROOT}/}" errs=0
  CHECKED=$((CHECKED + 1))
  local bytes; bytes="$(wc -c < "$file" | tr -d '[:space:]')"
  (( bytes >= 24000 )) && { fail "$rel" "Size (${bytes}B) >= 24000B limit"; errs=1; } || (( bytes >= 20000 )) && warn "$rel" "Size (${bytes}B) near 24000B limit"

  local lines=()
  while IFS= read -r line; do lines+=("$line"); done < <(parse_md "$file")
  local bounds="${lines[0]}" body="${lines[1]}" desc="${lines[3]}" trigger="${lines[4]}"

  [[ "$bounds" -eq 1 ]] || { fail "$rel" "Missing YAML frontmatter"; return; }
  case "$trigger" in
    always_on|model_decision|glob|manual) ;;
    *) fail "$rel" "Invalid or missing trigger '$trigger' (expected snake_case: always_on|model_decision|glob|manual)"; errs=1 ;;
  esac
  [[ "$trigger" == "model_decision" && -z "$desc" ]] && { fail "$rel" "'model_decision' requires 'description'"; errs=1; }
  [[ -z "$desc" ]] && warn "$rel" "Missing recommended 'description'"
  [[ "$body" -eq 1 ]] || { fail "$rel" "Rule Markdown body is empty"; errs=1; }
  [[ "$errs" -eq 0 ]] && pass "$rel (${bytes}B, trigger: ${trigger})"
}

section "1. Validating Plugin Manifests"
validate_json_file "${KIT_ROOT}/plugin.json"
validate_json_file "${KIT_ROOT}/.claude-plugin/plugin.json"

shopt -s nullglob
section "2. Validating Skills (skills/*/SKILL.md)"
for f in "${KIT_ROOT}"/skills/*/SKILL.md; do validate_named_md "$f" 1; done

section "3. Validating Rules (rules/**/*.md)"
for f in "${KIT_ROOT}"/rules/*/*.md; do validate_rule_file "$f"; done

section "4. Validating Subagents (agents/*.md)"
for f in "${KIT_ROOT}"/agents/*.md; do validate_named_md "$f" 0; done

printf "\n----------------------------------------\n"
printf "Files Checked: %d | Warnings: %d | Errors: %d\n" "$CHECKED" "$WARNINGS" "$ERRORS"
[[ "$ERRORS" -gt 0 ]] && { printf "\033[1;31m[FAIL] Validation failed with %d error(s).\033[0m\n" "$ERRORS"; exit 1; }
printf "\033[1;32m[OK] All agent-kit manifests, skills, rules, and agents are valid.\033[0m\n"
