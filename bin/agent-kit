#!/usr/bin/env bash
set -euo pipefail

KIT_ROOT="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
AGY_GLOBAL_DIR="${HOME}/.gemini/config"
CLAUDE_GLOBAL_DIR="${HOME}/.claude"

log_ok()   { printf "\033[1;32m[OK]\033[0m %s\n" "$1"; }
log_info() { printf "\033[1;34m[..]\033[0m %s\n" "$1"; }
log_warn() { printf "\033[1;33m[!!]\033[0m %s\n" "$1"; }

usage() {
  cat <<EOF
Usage: agent-kit <command> [arguments]

Commands:
  global                        Symlink all skills, agents, and global rules into ~/.gemini and ~/.claude
  learn [target-dir]            Inject Learning Mode (skills + no-spoiler rules + Copilot/Claude bridges) into a project
  eject [target-dir]            Remove injected Learning Mode symlinks from a project
  status [target-dir]           Show active skills and rules in global and target project scopes
  new-kata <dir-path>           Create a new directory, initialize git, and inject Learning Mode automatically
EOF
}

link_all() {
  local dst="$1"; shift; mkdir -p "$dst"
  for src in "$@"; do
    [[ -e "$src" ]] || continue
    local t="$dst/$(basename "$src")"
    rm -rf "$t" && ln -sfn "$src" "$t"
  done
}

cmd_global() {
  log_info "Linking global skills, agents, and safe global rules..."
  for dir in "$AGY_GLOBAL_DIR" "$CLAUDE_GLOBAL_DIR"; do
    link_all "$dir/skills" "${KIT_ROOT}/skills/"*
    link_all "$dir/rules"  "${KIT_ROOT}/rules/global/"*.md
    link_all "$dir/agents" "${KIT_ROOT}/agents/"*.md
    log_ok "Linked global skills, agents & rules in $dir"
  done
}

cmd_learn() {
  mkdir -p "${1:-.}"
  local target_dir
  target_dir="$(cd "${1:-.}" && pwd)"
  log_info "Injecting Craft Learning Environment into: ${target_dir}"

  mkdir -p "${target_dir}/.agents/rules" "${target_dir}/.github"
  for dir in "${target_dir}/.agents" "${target_dir}/.claude"; do
    link_all "$dir/skills" "${KIT_ROOT}/skills/craft-"*
    link_all "$dir/agents" "${KIT_ROOT}/agents/"*.md
  done
  for dst in ".agents/rules/learning-mode.md" "CLAUDE.md" ".github/copilot-instructions.md"; do
    ln -sfn "${KIT_ROOT}/rules/profiles/learning-mode.md" "${target_dir}/${dst}"
  done

  if [[ -d "${target_dir}/.git" ]]; then
    local ex="${target_dir}/.git/info/exclude"
    mkdir -p "$(dirname "$ex")" && touch "$ex"
    for p in ".agents/" ".claude/" "CLAUDE.md" ".github/copilot-instructions.md"; do
      grep -qxF "$p" "$ex" || echo "$p" >> "$ex"
    done
  fi

  log_ok "Learning Mode ACTIVE in ${target_dir}"
  log_info "Next step: Open your coding assistant in ${target_dir} and run /craft-blueprint"
}

cmd_eject() {
  local target_dir
  target_dir="$(cd "${1:-.}" && pwd)"
  log_warn "Removing Learning Mode links from: ${target_dir}"

  rm -rf "${target_dir}/.agents/rules/learning-mode.md" \
         "${target_dir}"/{.agents,.claude}/skills/craft-* \
         "${target_dir}"/{.agents,.claude}/agents/*.md
  [[ -L "${target_dir}/CLAUDE.md" ]] && rm -f "${target_dir}/CLAUDE.md"
  [[ -L "${target_dir}/.github/copilot-instructions.md" ]] && rm -f "${target_dir}/.github/copilot-instructions.md"

  log_ok "Learning Mode ejected from ${target_dir}."
}

cmd_status() {
  local target_dir
  target_dir="$(cd "${1:-.}" && pwd)"
  echo "=== Agent-Kit Status ==="
  echo "Repository Root: ${KIT_ROOT}"
  echo "Target Workspace: ${target_dir}"
  echo ""
  if [[ -L "${target_dir}/.agents/rules/learning-mode.md" ]]; then
    log_ok "Workspace Learning Mode (No-Spoiler): ACTIVE"
  else
    log_warn "Workspace Learning Mode (No-Spoiler): INACTIVE (Standard coding mode)"
  fi
  for scope in "Workspace:${target_dir}/.agents/skills" "Global:${AGY_GLOBAL_DIR}/skills"; do
    printf "\nLinked %s Skills (%s):\n" "${scope%%:*}" "${scope#*:}"
    [[ -d "${scope#*:}" ]] && ls -1 "${scope#*:}" | sed 's/^/  - /' || echo "  (none)"
  done
}

cmd_new_kata() {
  [[ -z "${1:-}" ]] && { log_warn "Usage: agent-kit new-kata <dir-path>"; exit 1; }
  mkdir -p "$1" && git -C "$1" init -q
  cmd_learn "$1"
  log_ok "Initialized new kata sandbox at $1"
}

case "${1:-}" in
  global)   cmd_global ;;
  learn)    cmd_learn "${2:-.}" ;;
  eject)    cmd_eject "${2:-.}" ;;
  status)   cmd_status "${2:-.}" ;;
  new-kata) cmd_new_kata "${2:-}" ;;
  *)        usage ;;
esac
